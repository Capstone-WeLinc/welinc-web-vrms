FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Spec 0010: the deploy passes the hosted addresses; the build refuses missing, http or localhost ones
ARG VITE_API_BASE_URL
ARG VITE_PORTAL_URL
# Spec 0025: optional, blank means off
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ARG VITE_SENTRY_RELEASE
ARG VITE_SENTRY_TUNNEL
ARG VITE_SENTRY_TEST_ROUTES
# true only for staging: the /dev/ui kit behind sign in
ARG VITE_DEV_UI
RUN npx vite build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
