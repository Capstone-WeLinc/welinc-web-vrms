# Committed dev defaults, loaded by `npm run dev` only. VITE_* values ship to the browser: never put secrets here.
# Personal overrides go in .env.local (ignored).
VITE_API_BASE_URL=http://localhost:3000
VITE_PORTAL_URL=http://localhost:8000

# Error monitoring (spec 0025): optional, blank means off. Set them in .env.development.local to test.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TUNNEL=
# VITE_SENTRY_TEST_ROUTES=

# true only in the staging build: the /dev/ui kit, behind sign in (development always has it)
# VITE_DEV_UI=
