# Both required (spec 0010): vite and vite build stop with a list when either is missing or malformed.
# A production build (npm run build) also needs https and no localhost; local builds use npm run build:local.
# VITE_* values ship to the browser: never put a secret here.
# The gateway the browser calls
VITE_API_BASE_URL=http://localhost:3000
# The SSO portal
VITE_PORTAL_URL=http://localhost:8000
