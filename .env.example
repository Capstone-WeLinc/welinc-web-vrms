# Both required (spec 0010): vite and vite build stop with a list when either is missing or malformed.
# A production build (npm run build) also needs https and no localhost; local builds use npm run build:local.
# VITE_* values ship to the browser: never put a secret here.
# The gateway the browser calls
VITE_API_BASE_URL=http://localhost:3000
# The SSO portal
VITE_PORTAL_URL=http://localhost:8000

# Error monitoring (VRMS spec 0025). All optional: leave them blank locally and nothing is sent.
# To prove it from your laptop, set the vrms-web project's DSN and VITE_SENTRY_ENVIRONMENT=staging.
# The deploy sets them hosted. A DSN can only send events, so it is fine in the browser.
VITE_SENTRY_DSN=
# staging or production
VITE_SENTRY_ENVIRONMENT=
# The commit SHA (the deploy job sets it)
VITE_SENTRY_RELEASE=
# The gateway route reports go through, <api>/monitoring/vrms-web (spec 0025, milestone 2). Blank sends straight to Sentry.
VITE_SENTRY_TUNNEL=
# true only in the staging build: the /debug/sentry test page (needs settings.manage, no menu link)
VITE_SENTRY_TEST_ROUTES=

# true only in the staging build: the /dev/ui kit, behind sign in (development always has it)
VITE_DEV_UI=
